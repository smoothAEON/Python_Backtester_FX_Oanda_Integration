# OANDA Candle Extractor - Configuration Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Ensure this file is saved in UTF-8 encoding (not UTF-16 or ANSI)

# ==========================================
# OANDA CONFIGURATION (Required)
# ==========================================
# Get your API key from OANDA (practice or live account)
OANDA_API_KEY=your_oanda_api_key_here
# Your OANDA account ID (format: XXX-XXX-XXXXXXXX-XXX)
OANDA_ACCOUNT_ID=your_oanda_account_id_here
# Required: OANDA environment must match your account type (practice or live)
OANDA_ENVIRONMENT=practice

# ==========================================
# OPTIONAL SETTINGS
# ==========================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# Data directory for cached market data (default: data)
DATA_DIR=data
